# Copy this file to .env for local development. Never commit the resulting
# .env file or replace these placeholders with production credentials here.

POSTGRES_USER=uam_app
POSTGRES_PASSWORD=REPLACE_WITH_A_SECRET
POSTGRES_DB=postgres
PG_PORT_HOST=55432
AUTH_DB=auth_service
USER_DB=user_service

SPRING_PROFILES_ACTIVE=docker,prod
SPRING_DATASOURCE_URL_AUTH=jdbc:postgresql://postgres-db:5432/auth_service
SPRING_DATASOURCE_URL_USER=jdbc:postgresql://postgres-db:5432/user_service
SPRING_DATASOURCE_USERNAME=uam_app
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_A_SECRET

# Generate a base64-encoded 256-bit value with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_BASE64_256_BIT_KEY
# During key rotation, keep the prior key here until all old tokens expire.
JWT_PREVIOUS_SECRET=
JWT_EXP_MINUTES=60

CORS_ALLOWED_ORIGINS=https://localhost
PUBLIC_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
AUTH_DEBUG_PORT=8081
USER_DEBUG_PORT=8082
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
